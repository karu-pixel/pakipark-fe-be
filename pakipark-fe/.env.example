# Mobile app config
EXPO_PUBLIC_APP_NAME=PakiPark
EXPO_PUBLIC_APP_ENV=development

# Backend API used by the mobile app.
# Same Wi-Fi testing:
# 1. Run ipconfig on the backend laptop.
# 2. Use the Wi-Fi IPv4 address, not localhost.
# Example: http://192.168.1.18:5000/api
#
# Deployed app:
# Use your hosted backend URL.
# Example: https://your-backend.onrender.com/api
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAPTOP_WIFI_IP:5000/api

# Supabase public values from Supabase Dashboard > Project Settings > API.
# These are safe for the mobile app because they are public client values.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
